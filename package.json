{
  "name": "ultima-conexion",
  "private": true,
  "version": "1.0.0",
  "description": "Juego narrativo de investigación digital con finalidad pastoral para centros juveniles salesianos.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "fotos": "node scripts/generar-fotos.mjs",
    "matriz": "vite-node scripts/generar-matriz.ts",
    "build:web": "vite build --mode single && node scripts/empaquetar-web.mjs"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "typescript": "5.8.3",
    "vite": "6.4.3",
    "vitest": "3.2.7"
  }
}
